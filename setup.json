{
  "schemaVersion": 2,
  "name": "Working With Markdown",
  "folder": "training-markdown",
  "repoUrl": "https://github.com/databankimx/training-markdown.git",
  "branch": "main",
  "baseDirectory": "C:\\Development\\training",
  "runTests": true,
  "installs": {
    "notepadPlusPlus": { "install": true, "winget": "Notepad++.Notepad++" },
    "git": {
      "install": true,
      "winget": "Git.Git"
    },
    "powershell7": {
      "install": true,
      "pinned": "7",
      "winget": "Microsoft.PowerShell"
    },
    "node": {
      "install": true,
      "pinned": "24",
      "orNewer": true,
      "winget": "OpenJS.NodeJS.LTS"
    },
    "vscode": {
      "install": true,
      "pinned": "1",
      "winget": "Microsoft.VisualStudioCode",
      "extensions": []
    },
    "buildTools": {
      "install": false
    },
    "vcRuntime": {
      "install": true
    }
  },
  "steps": [
    {
      "name": "Lesson runner packages",
      "type": "npm",
      "folder": "lesson-runner",
      "command": "ci",
      "requires": [
        "node"
      ]
    },
    {
      "name": "Lesson runner tests",
      "type": "npm-run",
      "folder": "lesson-runner",
      "script": "test",
      "runTests": true,
      "requires": [
        "node"
      ]
    }
  ],
  "launch": {
    "ide": "vscode",
    "kind": "electron",
    "folder": "lesson-runner"
  }
}
